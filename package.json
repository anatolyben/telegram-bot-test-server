{
  "name": "telegram-bot-test-server",
  "version": "0.13.1",
  "description": "A local test server for the Telegram Bot API, for testing bots: members, restrictions, join requests, invite links, multiple bots, channels, polls, business chats, Telegram Login, webhooks and callback buttons",
  "license": "MIT",
  "author": "Anatoly Ben",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./clock": {
      "types": "./src/clock.d.ts",
      "default": "./src/clock.js"
    }
  },
  "types": "./src/index.d.ts",
  "bin": {
    "telegram-bot-test-server": "bin/telegram-bot-test-server.js"
  },
  "files": [
    "src",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "telegram",
    "telegram-bot",
    "bot-api",
    "fake",
    "mock",
    "test-server",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatolyben/telegram-bot-test-server.git"
  },
  "scripts": {
    "test": "vitest run",
    "bench": "node bench/server.mjs"
  },
  "devDependencies": {
    "grammy": "^1.46.0",
    "telegraf": "^4.16.3",
    "vitest": "^3.2.6"
  }
}
