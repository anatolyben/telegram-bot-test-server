{
  "name": "telegram-bot-test-server",
  "version": "0.3.0",
  "description": "A local, in-memory fake of the Telegram Bot API for testing group bots: members, restrictions, join requests, invite links, webhooks and callback buttons",
  "license": "MIT",
  "author": "Anatoly Ben",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "types": "./src/index.d.ts",
  "bin": {
    "telegram-bot-test-server": "bin/telegram-bot-test-server.js"
  },
  "files": [
    "src",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "telegram",
    "telegram-bot",
    "bot-api",
    "fake",
    "mock",
    "test-server",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatolyben/telegram-bot-test-server.git"
  },
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "grammy": "^1.46.0",
    "telegraf": "^4.16.3",
    "vitest": "^3.2.6"
  }
}
