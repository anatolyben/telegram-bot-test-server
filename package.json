{
  "name": "telegram-bot-test-server",
  "version": "0.14.1",
  "description": "A local Telegram Bot API server for end-to-end tests: groups, members, moderation, buttons, webhooks and a live chat viewer. No Telegram account needed.",
  "license": "MIT",
  "author": "Anatoly Ben",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./clock": {
      "types": "./src/clock.d.ts",
      "default": "./src/clock.js"
    }
  },
  "types": "./src/index.d.ts",
  "bin": {
    "telegram-bot-test-server": "bin/telegram-bot-test-server.js"
  },
  "files": [
    "src",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "telegram",
    "telegram-bot",
    "bot-api",
    "fake",
    "mock",
    "test-server",
    "testing",
    "telegram-bot-api",
    "grammy",
    "telegraf",
    "e2e",
    "mock-server",
    "integration-testing",
    "moderation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anatolyben/telegram-bot-test-server.git"
  },
  "scripts": {
    "test": "vitest run",
    "bench": "node bench/server.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "~3.2.7",
    "grammy": "^1.46.0",
    "telegraf": "^4.16.3",
    "vitest": "^3.2.6"
  }
}
